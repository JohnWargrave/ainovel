# Copy to .env for local dev. Production: inject via secret manager (Doppler/Infisical), never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Docker Compose image and bind settings
BACKEND_IMAGE=backend:latest
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000

# Postgres container settings. Keep these values consistent with DATABASE_URL.
POSTGRES_USER=ainovel
POSTGRES_PASSWORD=ainovel
POSTGRES_DB=ainovel

# Local development connects through localhost. In docker-compose.prod.yml, use
# postgres://ainovel:<password>@postgres:5432/ainovel instead.
DATABASE_URL=postgres://ainovel:ainovel@localhost:5432/ainovel

# Local development connects through localhost. In docker-compose.prod.yml, use
# redis://redis:6379 instead.
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too

# pgcrypto column encryption key for delivery_code (12 §3) — never reuse dev value in prod
DELIVERY_CODE_ENC_KEY=dev-only-change-me-32-bytes-min

# Legacy server-to-server admin integration secret. Browser CMS login uses individual credentials.
ADMIN_API_KEY=dev-only-admin-api-key
# Legacy integration CSRF secret; browser sessions use per-session CSRF tokens.
ADMIN_CSRF_TOKEN=dev-only-admin-csrf-token
# Temporary compatibility for scripts using x-admin-api-key + x-admin-user-id. Keep false for CMS
# and production; remove after every integration has moved to individual admin sessions.
ENABLE_LEGACY_ADMIN_API_KEY=false
# HMAC secret used to derive per-session CMS CSRF tokens. Use a unique 32+ character value.
CMS_SESSION_SECRET=dev-only-cms-session-secret-32-bytes

# Development/QA-only admin ledger credit. The endpoint also refuses to run with NODE_ENV=production.
ENABLE_TEST_COIN_API=false

# Comma-separated IPs/CIDRs of reverse proxies allowed to supply X-Forwarded-For.
# Example for a local Nginx sidecar: TRUST_PROXY=127.0.0.1/32
TRUST_PROXY=

# Offerwall callback credentials and SDK placement names. Real values are never committed.
TAPJOY_POSTBACK_SECRET=
PUBSCALE_POSTBACK_SECRET=
TAPJOY_PLACEMENT=
PUBSCALE_PLACEMENT=

# Public app compatibility floor returned by GET /config.
MIN_SUPPORTED_APP_VERSION=1.0.0

# Public Nginx referral-link base. GET /referral appends /HP-XXXXXX.
# Leave blank until that Nginx host serves assetlinks.json and /r/{code}.
REFERRAL_SHARE_BASE_URL=

# OAuth providers — optional in dev/test (fake providers are injected in tests); required in production.
# Leave blank locally unless you have a real Google Cloud project / Facebook app to test against.
# GOOGLE_CLIENT_ID is the *Web* client ID — an Android sign-in sends the Web ID as the token's `aud`
# (the Android client ID only appears as `azp`), so configuring the Android one rejects every login.
# Comma-separate to accept more than one platform, e.g. "<web-id>,<ios-id>".
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Password account verification and recovery email. Cloudflare Email Sending must be enabled for
# AUTH_EMAIL_FROM's domain. The API token needs Email Sending permission for this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=noreply@example.com
AUTH_EMAIL_FROM_NAME=AINovel
AUTH_EMAIL_VERIFY_URL=https://app.example.com/verify-email
AUTH_PASSWORD_RESET_URL=https://app.example.com/reset-password

# Drama playback — required when enabling drama playback endpoints.
# DRAMA_PLAYBACK_SECRET signs short-lived playback tokens; use a unique production secret.
DRAMA_PLAYBACK_SECRET=dev-only-drama-playback-secret
# Base URL of the BytePlus VOD playback gateway/CDN.
DRAMA_PLAYBACK_BASE_URL=https://vod.invalid/play

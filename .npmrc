# Some hosts (e.g. Render) set NODE_ENV=production at the platform level even when the deploy
# config doesn't ask for it. pnpm otherwise treats NODE_ENV=production the same as --prod and
# silently skips devDependencies during install, which breaks the tsc/build step since typescript
# and its @types/* packages only live in devDependencies. Forcing production=false here makes
# `pnpm install` always install devDependencies regardless of NODE_ENV; it has no effect on what
# code actually runs at runtime.
production=false

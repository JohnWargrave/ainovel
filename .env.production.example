# Copy this file to .env on the deployment host.
# Do not commit the real file or real credentials.

# Compose infrastructure
PORT=3000
POSTGRES_USER=ainovel
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ainovel

# These hostnames resolve to the services in docker-compose.prod.yml.
DATABASE_URL=postgres://ainovel:replace-with-a-long-random-password@postgres:5432/ainovel
REDIS_URL=redis://redis:6379

NODE_ENV=production
LOG_LEVEL=info
MIN_SUPPORTED_APP_VERSION=1.0.0

# Public Nginx referral-link base. Example: https://link.your-domain.example/r
# Keep blank until that host serves /.well-known/assetlinks.json and /r/{code}.
REFERRAL_SHARE_BASE_URL=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DELIVERY_CODE_ENC_KEY=replace-with-a-32-byte-encryption-key
ADMIN_API_KEY=replace-with-admin-api-key
ADMIN_CSRF_TOKEN=replace-with-admin-csrf-token
ENABLE_LEGACY_ADMIN_API_KEY=false
CMS_SESSION_SECRET=replace-with-a-unique-32-character-session-secret
ENABLE_TEST_COIN_API=false

# Set only to the actual reverse-proxy addresses/CIDRs in front of this service.
TRUST_PROXY=

# Offerwall callback credentials and SDK placement names from the provider dashboards.
TAPJOY_POSTBACK_SECRET=
PUBSCALE_POSTBACK_SECRET=
TAPJOY_PLACEMENT=
PUBSCALE_PLACEMENT=

# Optional OAuth configuration
# GOOGLE_CLIENT_ID: the *Web* client ID (Android tokens carry it as `aud`; the Android client ID is
# only `azp`). Comma-separate to accept several platforms, e.g. "<web-id>,<ios-id>".
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudflare Email Service (required for password email verification and recovery)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=noreply@your-domain.example
AUTH_EMAIL_FROM_NAME=AINovel
AUTH_EMAIL_VERIFY_URL=https://your-app.example/verify-email
AUTH_PASSWORD_RESET_URL=https://your-app.example/reset-password

# Drama playback configuration
DRAMA_PLAYBACK_SECRET=replace-with-drama-playback-signing-secret
DRAMA_PLAYBACK_BASE_URL=https://your-byteplus-playback-gateway.example.com/play

# Optional BytePlus server-side integration credentials
BYTEPLUS_VOD_ACCESS_KEY=
BYTEPLUS_VOD_SECRET_KEY=
BYTEPLUS_VOD_REGION=ap-southeast-1
BYTEPLUS_VOD_SPACE_NAME=
BYTEPLUS_VOD_APP_ID=
